rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && userDoc().role == 'admin'; }
    // A store's document id is its owner's uid, so ownership needs no extra read.
    function ownsStore(storeId) { return signedIn() && request.auth.uid == storeId; }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt'])
        && request.resource.data.role in ['customer', 'seller'];
      // The role can never be changed from the client; admins are set by hand in the console.
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;
    }

    match /slugs/{slug} {
      allow get: if true;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['storeId']) && request.resource.data.storeId == request.auth.uid;
      allow delete: if ownsStore(resource.data.storeId);
    }

    match /stores/{storeId} {
      allow read: if true;
      allow create: if ownsStore(storeId) && request.resource.data.ownerId == request.auth.uid && userDoc().role == 'seller'
        && !('plan' in request.resource.data) && !('planUpdatedAt' in request.resource.data);
      // Sellers can't change their own plan; only an admin can (see the next rule).
      allow update: if ownsStore(storeId) && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.get('plan', null) == resource.data.get('plan', null)
        && request.resource.data.get('planUpdatedAt', null) == resource.data.get('planUpdatedAt', null);
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan', 'planUpdatedAt'])
        && request.resource.data.plan in ['free', 'growth', 'pro'];
      allow delete: if ownsStore(storeId);

      match /products/{productId} {
        allow read: if true;
        allow create, update: if ownsStore(storeId)
          && request.resource.data.name is string && request.resource.data.name.size() > 0
          && request.resource.data.price is number && request.resource.data.price >= 0
          && request.resource.data.stock is number && request.resource.data.stock >= 0;
        allow delete: if ownsStore(storeId);
      }
    }

    match /orders/{orderId} {
      // Order ids are unguessable 20-character ids, so the order link works as a private tracking link.
      allow get: if true;
      allow list: if signedIn() && (resource.data.storeId == request.auth.uid || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.resource.data.keys().hasOnly(['storeId', 'storeName', 'storeSlug', 'userId', 'customer', 'items', 'subtotal', 'deliveryFee', 'total', 'payment', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.total is number && request.resource.data.total > 0
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 50
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/stores/$(request.resource.data.storeId))
        && (request.resource.data.userId == null || request.resource.data.userId == request.auth.uid);
      allow update: if signedIn() && resource.data.storeId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'payment'])
        && request.resource.data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled'];
      allow delete: if false;
    }
  }
}
